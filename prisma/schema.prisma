generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  MONTIR
  ADMIN
}

enum OrderStatus {
  REQUESTED
  MATCHING
  MECHANIC_ASSIGNED
  MECHANIC_ACCEPTED
  ON_THE_WAY
  ARRIVED
  DIAGNOSING
  REPAIRING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  QRIS
  GOPAY
  DANA
  BANK_TRANSFER
}

enum ActivityType {
  LOGIN
  LOGOUT
  REGISTER
  CREATE_ORDER
  ACCEPT_ORDER
  REJECT_ORDER
  CANCEL_ORDER
  COMPLETE_ORDER
  UPDATE_STATUS
  ONLINE
  OFFLINE
  AI_DIAGNOSIS
  PAYMENT
  RATING
}

model User {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  password     String
  phoneNumber  String?
  role         Role      @default(CLIENT)
  avatarUrl    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clientOrders           Order[]          @relation("ClientOrders")
  montirOrders           Order[]          @relation("MontirOrders")
  serviceRequestsAsClient ServiceRequest[] @relation("ServiceRequestClient")
  serviceRequestsAsMontir ServiceRequest[] @relation("ServiceRequestMontir")
  vehicles               Vehicle[]        @relation("UserVehicle")
  profile                Profile?
  mechanicDetail         MechanicDetail?
  earnings               Earnings[]       @relation("MechanicEarnings")
  activityLogs           ActivityLog[]    @relation("UserActivityLogs")
  notifications          Notification[]   @relation("UserNotifications")
  reviewsGiven           Review[]         @relation("ReviewClient")
  reviewsReceived        Review[]         @relation("ReviewMontir")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String?
  address     String?
  avatarUrl   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vehicle {
  id               String         @id @default(uuid())
  ownerId          String
  owner            User           @relation("UserVehicle", fields: [ownerId], references: [id], onDelete: Cascade)
  type             String
  brand            String
  model            String
  year             Int?
  licensePlate     String?
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  orders           Order[]        @relation("OrderVehicle")
  serviceRequests  ServiceRequest[] @relation("ServiceRequestVehicle")
}

model MechanicDetail {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOnline      Boolean  @default(false)
  currentLat    Float?
  currentLng    Float?
  rating        Float    @default(5.0)
  totalEarnings Decimal  @default(0.0) @db.Decimal(12, 2)
  specialization String?
  status        String   @default("offline")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id                        String        @id @default(uuid())
  clientId                  String
  client                    User          @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade)
  montirId                  String?
  montir                    User?         @relation("MontirOrders", fields: [montirId], references: [id], onDelete: SetNull)
  vehicleId                 String?
  vehicle                   Vehicle?      @relation("OrderVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  status                    OrderStatus   @default(REQUESTED)
  clientLat                 Float
  clientLng                 Float
  clientAddress             String        @db.Text
  vehicleIssueDescription   String        @db.Text
  symptoms                  String?       @db.Text
  totalPrice                Decimal?      @db.Decimal(12, 2)
  paymentStatus             PaymentStatus @default(PENDING)
  paymentMethod             PaymentMethod?
  qrCode                    String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
}

model ServiceRequest {
  id                        String        @id @default(uuid())
  clientId                  String
  client                    User          @relation("ServiceRequestClient", fields: [clientId], references: [id], onDelete: Cascade)
  montirId                  String?
  montir                    User?         @relation("ServiceRequestMontir", fields: [montirId], references: [id], onDelete: SetNull)
  vehicleId                 String?
  vehicle                   Vehicle?      @relation("ServiceRequestVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  status                    OrderStatus   @default(REQUESTED)
  clientLat                 Float
  clientLng                 Float
  clientAddress             String        @db.Text
  vehicleIssueDescription   String        @db.Text
  symptoms                  String?       @db.Text
  aiDiagnosis               AiDiagnosis?  @relation("ServiceRequestAiDiagnosis")
  totalPrice                Decimal?      @db.Decimal(12, 2)
  paymentStatus             PaymentStatus @default(PENDING)
  paymentMethod             PaymentMethod?
  qrCode                    String?
  payment                   Payment?      @relation("ServiceRequestPayment")
  createdAt                 DateTime      @default(now())
  acceptedAt                DateTime?
  startedAt                 DateTime?
  completedAt               DateTime?
  cancelledAt               DateTime?
  reviews                   Review[]      @relation("ServiceRequestReviews")
  statusHistory             ServiceRequestStatusHistory[] @relation("StatusHistory")
  earnings                  Earnings[]    @relation("EarningsServiceRequest")
  updatedAt                 DateTime      @updatedAt
}

model AiDiagnosis {
  id                  String          @id @default(uuid())
  serviceRequestId    String?         @unique
  serviceRequest      ServiceRequest? @relation("ServiceRequestAiDiagnosis", fields: [serviceRequestId], references: [id], onDelete: Cascade)
  possibleIssues      Json?
  symptoms            Json?
  riskLevel           String?
  recommendedChecks   Json?
  suggestedTools      Json?
  estimatedComplexity String?
  questionsForClient  Json?
  createdAt           DateTime        @default(now())
}

model ServiceRequestStatusHistory {
  id               String        @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation("StatusHistory", fields: [serviceRequestId], references: [id], onDelete: Cascade)
  previousStatus   OrderStatus
  newStatus        OrderStatus
  changedAt        DateTime      @default(now())
  changedBy        String?
}

model Payment {
  id               String        @id @default(uuid())
  serviceRequestId String        @unique
  serviceRequest   ServiceRequest @relation("ServiceRequestPayment", fields: [serviceRequestId], references: [id], onDelete: Cascade)
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  paymentGateway   String?
  transactionId    String?
  paymentStatus    PaymentStatus @default(PENDING)
  qrCode           String?
  paidAt           DateTime?
  expiredAt        DateTime?
  createdAt        DateTime      @default(now())
  events           PaymentEvent[] @relation("PaymentEvents")
  earnings         Earnings[]    @relation("PaymentEarnings")
}

model PaymentEvent {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation("PaymentEvents", fields: [paymentId], references: [id], onDelete: Cascade)
  eventType   String
  description String?
  occurredAt  DateTime @default(now())
}

model Earnings {
  id               String          @id @default(uuid())
  mechanicId       String
  mechanic         User            @relation("MechanicEarnings", fields: [mechanicId], references: [id], onDelete: Cascade)
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation("EarningsServiceRequest", fields: [serviceRequestId], references: [id], onDelete: SetNull)
  paymentId        String?
  payment          Payment?        @relation("PaymentEarnings", fields: [paymentId], references: [id], onDelete: SetNull)
  grossAmount      Decimal         @db.Decimal(12, 2)
  platformFee      Decimal         @db.Decimal(12, 2)
  netAmount        Decimal         @db.Decimal(12, 2)
  period           String
  calculatedAt     DateTime        @default(now())
}

model ActivityLog {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)
  activityType  ActivityType
  description   String?
  relatedEntity String?
  relatedId     String?
  timestamp     DateTime     @default(now())
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title         String
  message       String
  type          String
  relatedEntity String?
  relatedId     String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Review {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation("ServiceRequestReviews", fields: [serviceRequestId], references: [id], onDelete: Cascade)
  clientId         String
  client           User           @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  montirId         String?
  montir           User?          @relation("ReviewMontir", fields: [montirId], references: [id], onDelete: SetNull)
  rating           Int
  comment          String?        @db.Text
  createdAt        DateTime       @default(now())
}
