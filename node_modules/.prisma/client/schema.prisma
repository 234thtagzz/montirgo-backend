generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  MONTIR
}

enum OrderStatus {
  SEARCHING
  ACCEPTED
  ON_THE_WAY
  WORKING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  password    String
  phoneNumber String
  role        Role     @default(CLIENT)
  avatarUrl   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mechanic     MechanicDetail?
  clientOrders Order[]         @relation("ClientOrders")
  montirOrders Order[]         @relation("MontirOrders")
}

model MechanicDetail {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOnline      Boolean @default(false)
  currentLat    Float?
  currentLng    Float?
  rating        Float   @default(5.0)
  totalEarnings Decimal @default(0.0) @db.Decimal(12, 2)
}

model Order {
  id                      String        @id @default(uuid())
  clientId                String
  client                  User          @relation("ClientOrders", fields: [clientId], references: [id])
  montirId                String?
  montir                  User?         @relation("MontirOrders", fields: [montirId], references: [id])
  status                  OrderStatus   @default(SEARCHING)
  clientLat               Float
  clientLng               Float
  clientAddress           String        @db.Text
  vehicleIssueDescription String        @db.Text
  aiDiagnosisResult       Json?
  totalPrice              Decimal       @db.Decimal(12, 2)
  paymentStatus           PaymentStatus @default(PENDING)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}
